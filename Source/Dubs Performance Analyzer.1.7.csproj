<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutDir>..\1.7\Assemblies\</OutDir>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RimWorld17 Condition="'$(RimWorld17)' == ''">..\..\..</RimWorld17>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE;NDEBUG;V1_7</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>TRACE;DEBUG;V1_7</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- RimWorld 1.7 runs on .NET 10; Harmony 2 does not, so 1.7 bundles Harmony 3. -->
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
		<PackageReference Remove="PolySharp" />
		<PackageReference Update="Krafs.Publicizer" Version="2.3.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<Publicize Remove="Assembly-CSharp;UnityEngine.CoreModule" />
		<Publicize Include="Assembly-CSharp;UnityStubs" MemberPattern="(?!(?:[^.\r\n\s]+\.){2,}?I[^.\r\n\s]+\.[^.\r\n\s]+)^.*" />
		<Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="UnityStubs"><HintPath>$(RimWorld17)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
		<Reference Include="Waylith"><HintPath>$(RimWorld17)\Waylith.dll</HintPath><Private>false</Private></Reference>
	</ItemGroup>
</Project>
